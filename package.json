{
  "name": "mewcode-agent",
  "version": "0.1.0",
  "description": "A modular CLI coding agent built with TypeScript and Node.js",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "mewcode": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hqyx2025/MewcodeAgent.git"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "demo": "tsx src/cli/index.ts demo",
    "chat": "node --env-file-if-exists=.env.local --import tsx src/cli/index.ts chat",
    "agent": "node --env-file-if-exists=.env.local --import tsx src/cli/index.ts run",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:package": "tsx scripts/smoke-package.ts",
    "bench:tools": "tsx scripts/benchmark-tools.ts",
    "bench:agent": "tsx scripts/benchmark-agent.ts",
    "bench:prompt": "tsx scripts/benchmark-prompt.ts",
    "bench:permissions": "tsx scripts/benchmark-permissions.ts",
    "bench:mcp": "tsx scripts/benchmark-mcp.ts",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:boundaries && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "ink": "8.0.0",
    "js-yaml": "5.4.2",
    "openai": "7.28.0",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
